            "function": "async function processRequest(input) {\n    let worlda = getVar(\"worlda\") || [];\n    \n    if (!worlda || worlda.length === 0) {\n        return {ok: false, error: \"No world data found\"};\n    }\n    \n    let worlddata = worlda.find(item => item.id === 'world');\n    if (!worlddata || !worlddata.size?.w || !worlddata.size?.h) {\n        return {ok: false, error: \"Invalid world size\"};\n    }\n    \n    let worldWidth = worlddata.size.w;\n    let worldHeight = worlddata.size.h;\n    \n    let objectsdata = worlda.filter(item => item.id !== 'world');\n    \n    if (objectsdata.length === 0) {\n        return {ok: true, message: \"No objects to layout\"};\n    }\n    \n    // 準備 AI prompt\n    let objectsList = objectsdata.map(o => `${o.id} (${o.name || 'unnamed'})`).join(', ');\n    let userPrompt = `World size: ${worldWidth}x${worldHeight}. Objects: ${objectsList}. \n    Assign non-overlapping grid positions (x:0-${worldWidth-1}, y:0-${worldHeight-1}) to each object. \n    Logical layout: machines on edges, players center. \n    Respond ONLY with valid JSON array: [{\"id\":\"obj1\",\"position\":{\"x\":1,\"y\":2}},{\"id\":\"obj2\",\"position\":{\"x\":3,\"y\":0}}]`;\n    \n    let systemPrompt = 'You are a game level designer. Output only valid JSON array of positions, no other text.';\n    \n    try {\n        const resp = await fetch('https://aichat.maxsolo.co.uk/api/chat', {\n            method: 'POST',\n            headers: { 'Content-Type': 'application/json' },\n            body: JSON.stringify({ \n                role: 'user', \n                prompt: userPrompt, \n                system: systemPrompt \n            })\n        });\n        \n        const chatData = await resp.json();\n        let aiResponse = chatData.content.trim();\n        \n        console.log('AI Layout Response:', aiResponse);\n        \n        // Parse JSON (handle minor formatting issues)\n        let positions;\n        try {\n            positions = JSON.parse(aiResponse);\n        } catch (e) {\n            // Fallback: try extract JSON from text\n            let jsonMatch = aiResponse.match(/\\[.*\\]/s);\n            if (jsonMatch) {\n                positions = JSON.parse(jsonMatch[0]);\n            } else {\n                throw e;\n            }\n        }\n        \n        // 應用 positions\n        positions.forEach(pos => {\n            let obj = objectsdata.find(o => o.id === pos.id);\n            if (obj && pos.position) {\n                obj.position = { \n                    x: Math.max(0, Math.min(worldWidth - 1, pos.position.x)), \n                    y: Math.max(0, Math.min(worldHeight - 1, pos.position.y)) \n                };\n            }\n        });\n        \n        console.log('AI Positions Applied:', objectsdata.map(o => ({id: o.id, pos: o.position})));\n        \n    } catch (error) {\n        console.error('AI Layout failed:', error);\n        return {ok: false, error: 'AI layout failed, using manual'};\n        // 可 fallback 你的初版 zigzag\n    }\n    \n    let updatedWorld = [worlddata, ...objectsdata];\n    setVar(\"worlda\", updatedWorld);\n    \n    return {\n        ok: true,\n        updated: objectsdata.length,\n        worldSize: {w: worldWidth, h: worldHeight},\n        layout: 'AI auto',\n        objectsMoved: objectsdata.map(o => ({id: o.id, newPos: o.position}))\n    };\n}\n",
