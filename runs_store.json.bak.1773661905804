            "apiName": "MoveObjectController",
            "apiUrl": null,
            "image": null,
            "function": "// MoveObjectsController\nasync function processRequest(input) {\n  console.log(\"move objects\", input);\n  const objects = input.var?.objectActions || [];\n\n  const clientJS = `\n    const configs = ${JSON.stringify(objects)};\n\n    console.log(\"MoveObjectsController start\", configs);\n\n    if (!Array.isArray(configs) || configs.length === 0) {\n      console.warn(\"MoveObjectsController: no objects\");\n      return;\n    }\n\n    const items = [];\n\n    configs.forEach(cfg => {\n      if (!cfg || !cfg.selector) return;\n      let el = document.getElementById(cfg.selector);  // Use selector as ID\n      if (!el) {\n        console.warn(\"MoveObjectsController: element not found\", cfg.selector);\n        return;\n      }\n\n      const style = window.getComputedStyle(el);\n      if (style.position === \"static\") {\n        el.style.position = \"absolute\";\n      }\n\n      const rect = el.getBoundingClientRect();\n      const startX = rect.left + window.scrollX;\n      const startY = rect.top + window.scrollY;\n\n      const targetX = cfg.targetX ?? startX;\n      const targetY = cfg.targetY ?? startY;\n      const speed = cfg.speed ?? 200;  // px/s\n\n      items.push({\n        el, startX, startY, targetX, targetY, speed, done: false\n      });\n    });\n\n    if (items.length === 0) {\n      console.warn(\"MoveObjectsController: no valid items\");\n      return;\n    }\n\n    let startTime = null;\n\n    function step(timestamp) {\n      if (!startTime) startTime = timestamp;\n      const elapsed = (timestamp - startTime) / 1000;\n\n      let allDone = true;\n\n      items.forEach(item => {\n        if (item.done) return;\n\n        const dx = item.targetX - item.startX;\n        const dy = item.targetY - item.startY;\n        const distance = Math.sqrt(dx * dx + dy * dy);\n        if (distance === 0) {\n          item.done = true;\n          return;\n        }\n\n        const duration = distance / item.speed;\n        const t = Math.min(elapsed / duration, 1);\n\n        const x = item.startX + dx * t;\n        const y = item.startY + dy * t;\n\n        item.el.style.left = x + \"px\";\n        item.el.style.top = y + \"px\";\n\n        if (t >= 1) {\n          item.done = true;\n        } else {\n          allDone = false;\nconst resp = fetch('http://localhost:3001/run/main');\n        }\n      });\n\n      if (!allDone) {\n        window.requestAnimationFrame(step);\n      }\n    }\n\n    window.requestAnimationFrame(step);\n  `;\n\nconst resp = fetch('http://localhost:3001/run/Game1runner');\n  return {\n    status: \"ready\",\n    clientJS,\n  };\n}\n",
