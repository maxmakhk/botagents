            "apiUrl": null,
            "image": "https://maxsolo.co.uk/images/uploads/img_699f62e71a3769.83305628.jpg",
            "function": "async function processRequest(input) {\n  const worldA = getVar(\"worldA\") || [];\n  \n  let worldItem = worldA.find(m => m.id === \"world\");\n  if (!worldItem) {\n    worldItem = {\n      id: \"world\",\n      name: \"world\",\n      position: { x: 0, y: 0, z: 0 },\n      size: { w: 5, h: 5, d: 1 },\n      imageurl: \"https://aiagent.maxsolo.co.uk/images/virualspace_b.png\",\n      zIndex: 0,\n      status: \"idle\",\ndialogue: {\n        text: \"歡迎來到這台工業設備的控制室。\"\n      }\n    };\n    worldA.push(worldItem);\n  } else {\n    if (!worldItem.hasOwnProperty(\"zIndex\")) {\n      worldItem.zIndex = 0;\n    }\n  }\n\n  // 示例：一個有長期對話文字的物件（之後可以由 AI 填）\n  let npc = worldA.find(m => m.id === \"npc_1\");\n  if (!npc) {\n    npc = {\n      id: \"npc_1\",\n      name: \"Technician\",\n      position: { x: 1, y: 1, z: 0 },\n      size: { w: 1, h: 1, d: 1 },\n      imageurl: \"https://aiagent.maxsolo.co.uk/images/npc_technician.png\",\n      zIndex: 10,\n      status: \"idle\",\n      dialogue: {\n        text: \"歡迎來到這台工業設備的控制室。\"\n      }\n    };\n    worldA.push(npc);\n  }\n\n  setVar(\"worldA\", worldA);\n\n  const tileSize = 64;\n\n  let clientJS = `\n    (function() {\n      const tileSize = ${tileSize};\n      const outputBody = document.getElementById('output-body');\n      if (!outputBody) return;\n\n      const worldA = ${JSON.stringify(worldA)};\n\n      // Step 1: add / update elements\n      worldA.forEach(function(item) {\n        var el = document.getElementById(item.id);\n        if (!el) {\n          el = document.createElement('div');\n          el.id = item.id;\n          el.style.position = 'absolute';\n          el.style.border = '1px solid #000';\n          if (item.imageurl) {\n            el.style.backgroundImage = 'url(' + item.imageurl + ')';\n            el.style.backgroundSize = '100% 100%';\n            el.style.backgroundPosition = 'center';\n          } else {\n            el.style.backgroundColor = (item.color || 'rgba(255, 255, 255, 0.5)');\n          }\n\n          if (item.zIndex === undefined) {\n            el.style.zIndex = 1;\n          } else {\n            el.style.zIndex = item.zIndex;\n          }\n          outputBody.appendChild(el);\n        }\n\n        el.style.left = (item.position.x * tileSize) + 'px';\n        el.style.top = (item.position.y * tileSize) + 'px';\n        el.style.width = (item.size.w * tileSize) + 'px';\n        el.style.height = (item.size.h * tileSize) + 'px';\n\n        var label = el.querySelector('.label');\n        if (!label) {\n          label = document.createElement('div');\n          label.className = 'label';\n          label.style.position = 'absolute';\n          label.style.bottom = '0';\n          label.style.left = '0';\n          label.style.background = 'rgba(0,0,0,0.7)';\n          label.style.color = 'white';\n          label.style.fontSize = '10px';\n          label.style.padding = '2px';\n          el.appendChild(label);\n        }\n        label.textContent = item.name || item.id;\n\n        // === Dialogue：長期顯示在物件旁邊（下方） ===\n        // 清除舊的 dialogue element\n        var oldDlg = el.querySelector('.dialogue-text');\n        if (oldDlg) oldDlg.remove();\n\n        if (item.dialogue && item.dialogue.text) {\n          var dlg = document.createElement('div');\n          dlg.className = 'dialogue-text';\n          dlg.style.position = 'absolute';\n          dlg.style.top = '100%';          // 在物件下方\n          dlg.style.left = '0';\n          dlg.style.marginTop = '2px';\n          dlg.style.background = 'rgba(0, 0, 0, 0.7)';\n          dlg.style.color = 'white';\n          dlg.style.fontSize = '10px';\n          dlg.style.padding = '2px 4px';\n          dlg.style.whiteSpace = 'nowrap';\n          dlg.textContent = item.dialogue.text;\n          el.appendChild(dlg);\n        }\n      });\n\n      // Step 2: remove elements not in worldA\n      var worldIds = worldA.map(function(i){ return i.id; });\n      var allEls = Array.prototype.slice.call(\n        outputBody.querySelectorAll('div[id]')\n      );\n      allEls.forEach(function(el) {\n        if (worldIds.indexOf(el.id) === -1) {\n          el.remove();\n        }\n      });\n    })();\n  `;\n\n  return {\n    status: \"ready\",\n    clientJS,\n  };\n}\n",
